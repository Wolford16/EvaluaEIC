Options -Indexes -MultiViews
DirectoryIndex index.php
CGIPassAuth On

RewriteEngine On
RewriteRule ^(?:index\.php)?$ - [END]
RewriteRule ^crear_administrador\.php$ - [END]
RewriteRule ^((?:css|js|imagenes)/[A-Za-z0-9_/-]+\.(?:css|js|png|svg))$ publico/$1 [END]
RewriteRule ^verificar_bd\.php$ index.php [END]
RewriteRule ^resultados/[A-Za-z0-9-]{4,12}(?:/[1-9][0-9]*)?\.(?:pdf|xlsx)$ index.php [END]
RewriteRule ^(?:ingreso|admin|docente|participar|(?:api|archivo|sala)/[A-Za-z0-9-]+)/?$ index.php [END]
RewriteRule ^ - [F]
